# Configurazione per Assistente WhatsApp Euronics Comiso

# Twilio Auth Token per validare le richieste webhook (trovato nella Twilio Console)
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Chiave API Gemini (Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Modello Gemini da utilizzare (default consigliato: gemini-2.0-flash o gemini-1.5-flash)
GEMINI_MODEL=gemini-2.0-flash

# Backend SDK facoltativo: google-genai (default) o google-generativeai
# GEMINI_BACKEND=google-genai

# Imposta a true SOLO durante test locali manuali con curl/Postman senza firma Twilio valida
SKIP_TWILIO_VALIDATION=false

# Porta su cui ascolta il server locale (Flask)
PORT=5000
